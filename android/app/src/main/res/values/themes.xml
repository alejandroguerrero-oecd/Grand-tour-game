<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GrandTour" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/parchment</item>
        <item name="android:statusBarColor">@color/parchment_dark</item>
        <item name="android:navigationBarColor">@color/parchment_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.GrandTour.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/parchment</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.GrandTour</item>
    </style>
</resources>
